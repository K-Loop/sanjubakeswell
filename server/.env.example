# ── Sanjus Bakesvelle Server — Environment Variables ──
# Copy this to .env and fill in your real values.

NODE_ENV=production
PORT=5000

# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/sanjus-bakesvelle?retryWrites=true&w=majority

# JWT secret (use a long random string)
JWT_SECRET=change_this_to_a_very_long_random_secret_string

# Admin credentials (seeded on first startup)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me

# Allowed frontend origin(s), comma separated (CORS). Not needed if Nginx serves both on one domain.
FRONTEND_URL=https://your-domain.com

# Number of reverse proxies in front of Node (Nginx = 1) — required for correct rate limiting
TRUST_PROXY=1

# ── Image storage ────────────────────────────────────────────────────────────
# PERSISTENT directory OUTSIDE the deployed code folder so deploys/PM2 restarts never touch it.
UPLOAD_DIR=/var/lib/sanjus/uploads
# Image storage budget in bytes (7 GB = 7516192768). This is NOT the VPS disk size.
STORAGE_LIMIT_BYTES=7516192768
STORAGE_WARN_PERCENT=80
STORAGE_CRITICAL_PERCENT=95
# Max size of ONE uploaded file before optimisation
MAX_UPLOAD_MB=20
# Optimisation tuning (defaults shown)
IMAGE_MAX_DIMENSION=2400
IMAGE_WEBP_QUALITY=85
IMAGE_THUMB_WIDTH=480
IMAGE_CONCURRENCY=2
# Directory containing the ORIGINAL site images (the frontend's /public folder) used by the
# one-time first-deploy migration. Only needed on the first start.
SEED_SOURCE_DIR=/var/www/sanjus/public
